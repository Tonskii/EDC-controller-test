{
  "Urls": "http://0.0.0.0:8088",

  "Push": {
    "ServerName": "EDC-Test",
    "ServerVersion": "3.0.1",
    "PushProtVer": "3.0.1",
    "LegacyPushVersionLine": "",
    "AnswerRegistryOkForKnownDevices": false,
    "ErrorDelay": 30,
    "RequestDelay": 3,
    "TransTimes": "00:00;14:00",
    "TransInterval": 1,
    "TransTables": "User Transaction",
    "Realtime": 1,
    "TimeoutSec": 10,
    "EchoNsLevel": true,
    "CmdFormat": "auto",
    "MaxCommandsPerPoll": 1,
    "ResendUnansweredAfterSeconds": 0,
    "ExchangeResponseStatus": 404,
    "TimeZone": "Europe/Ljubljana",
    "RtDataTimeMode": "gmt",
    "ConnectionClose": true
  },

  "TrafficLog": {
    "ShowHeartbeat": false,
    "RtState": "changes",
    "ShowHeaders": true,
    "ShowBodies": true,
    "MaxBodyChars": 6000,
    "HeartbeatSummarySeconds": 60,
    "FileFolder": "logs"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*"
}
